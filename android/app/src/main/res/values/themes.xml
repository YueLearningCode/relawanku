<?xml version="1.0" ?>
<resources>

    <style name="Base.Theme.Relawanku" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorPrimaryContainer">@color/sage</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/primary_dark</item>
        <item name="colorSecondaryContainer">@color/sage</item>
        <item name="colorOnSecondaryContainer">@color/primary_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="materialButtonStyle">@style/Widget.Relawanku.Button</item>
    </style>

    <style name="Theme.Relawanku" parent="Base.Theme.Relawanku" />

    <style name="Widget.Relawanku.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="TextAppearance.Relawanku.Navigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="TextAppearance.Relawanku.Navigation.Active" parent="TextAppearance.Relawanku.Navigation">
        <item name="android:fontFamily">@font/nunito_bold</item>
    </style>
</resources>
